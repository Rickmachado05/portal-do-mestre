{
  "name": "hexatombe-mesa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:multiplayer": "node scripts/dev-multiplayer.mjs",
    "server:multiplayer": "node scripts/multiplayer-server.mjs",
    "test:multiplayer": "node --test scripts/multiplayer-*.test.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:impeto": "tsc -p tsconfig.impeto-tests.json && node scripts/rodar-testes-impeto.cjs",
    "test:ui-impeto": "node scripts/teste-ui-impeto-v16.cjs && node scripts/teste-ui-impeto-v17.cjs && node scripts/teste-ui-impeto-v18.cjs && node scripts/teste-subtabs-tecnicas-v20.cjs",
    "test:biblioteca-mestre": "npm run test:impeto && node scripts/teste-biblioteca-mestre-v19.cjs",
    "test:dimensoes-token-3d": "node scripts/teste-dimensoes-token-3d-v23.cjs",
    "test:tokens-idle": "node --test scripts/teste-token-idle-v21.mjs && node scripts/teste-token-idle-integracao-v21.cjs && node --test scripts/teste-token-idle-nitidez-v22.mjs && node scripts/teste-token-idle-nitidez-integracao-v22.cjs",
    "test:navegacao-mesas": "node scripts/teste-navegacao-mesas-v24.cjs",
    "test:toolbar-token-3d": "node scripts/teste-toolbar-token-3d-v25.cjs",
    "test:painel-dimensoes-v26": "node scripts/teste-painel-dimensoes-v26.cjs",
    "test:pre-v28": "node scripts/teste-polimento-v27-1.cjs",
    "test:biblioteca-idles": "node scripts/teste-biblioteca-idles-v28.cjs",
    "test:biblioteca-tokens": "node scripts/teste-biblioteca-tokens-v29.cjs && node scripts/teste-imports-windows-v29-1.cjs",
    "test:retrato-estilo": "node scripts/teste-retrato-e-estilo-v29-2.cjs && node scripts/teste-persistencia-retrato-v29-2.cjs",
    "test:retrato-responsivo": "node scripts/teste-retrato-responsivo-v29-3.cjs",
    "test:miniaturas-3d": "node scripts/teste-miniaturas-v29-15.cjs && node scripts/teste-miniaturas-v29-15-1.cjs && node scripts/teste-miniaturas-v29-15-2.cjs && node scripts/teste-miniaturas-v29-15-3.cjs && node scripts/teste-miniaturas-interface-v29-15-5.cjs && node scripts/teste-miniaturas-global-v29-15-6.cjs && node scripts/teste-miniaturas-multiselecao-v29-15-7.cjs",
    "test:estabilidade": "node scripts/teste-estabilidade-v29-4.cjs && node --test scripts/multiplayer-estabilidade-seis-jogadores.test.mjs scripts/multiplayer-homologacao-seis-v29-15-28.test.mjs",
    "test:ocultacao-elenco": "node scripts/teste-ocultacao-elenco-v29-6.cjs",
    "test:anotacoes-iluminacao": "node scripts/teste-anotacoes-iluminacao-v29-7.cjs",
    "test:editor-luz": "node scripts/teste-editor-luz-compacto-v29-8-2.cjs",
    "test:backup": "node scripts/teste-backup-v29-15-4.cjs",
    "test:homologacao-seis": "node --test scripts/multiplayer-homologacao-seis-v29-15-28.test.mjs",
    "cloudflare:build": "node scripts/gerar-kit-publico.mjs && vite build",
    "cloudflare:start": "node scripts/iniciar-cloudflare.mjs",
    "test:musica": "node --test scripts/multiplayer-musica-sessao.test.mjs scripts/multiplayer-musica-websocket.test.mjs",
    "test:vercel": "node --test scripts/multiplayer-vercel-deploy.test.mjs",
    "test:auxiliar-mestre": "node --test scripts/auxiliar-mestre/auxiliar-mestre.test.mjs"
  },
  "dependencies": {
    "@3d-dice/dice-box": "^1.1.4",
    "@3d-dice/dice-box-threejs": "^0.0.12",
    "cannon-es": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0",
    "jspdf": "^4.2.1",
    "fflate": "~0.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
